{
  "name": "@local/dsh-browser-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Drive the Windows DSH Desktop right-sidebar browser through playwright-cli, with a per-session page identity.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "browser-automation",
    "playwright",
    "sidebar",
    "cdp"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src/**/*.js",
    "docs/*.md",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test --test-timeout=30000 test/*.test.js"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-browser"
      ]
    }
  }
}
