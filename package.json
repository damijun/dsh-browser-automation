{
  "name": "dsh-browser-automation",
  "version": "0.2.0",
  "description": "Drive the Windows DSH Desktop right-sidebar browser through playwright-cli, with a per-session page identity.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "browser-automation",
    "playwright",
    "playwright-cli",
    "sidebar",
    "cdp",
    "windows"
  ],
  "license": "MIT",
  "author": "damijun",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damijun/dsh-browser-automation.git"
  },
  "homepage": "https://github.com/damijun/dsh-browser-automation#readme",
  "bugs": {
    "url": "https://github.com/damijun/dsh-browser-automation/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src/**/*.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test --test-timeout=30000 test/*.test.js",
    "prepublishOnly": "npm test",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-browser"
      ]
    }
  }
}
